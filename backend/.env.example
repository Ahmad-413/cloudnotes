# --- Server ---
PORT=8080
NODE_ENV=production

# --- Database (RDS PostgreSQL) ---
# Either set DATABASE_URL directly, or the discrete fields below.
DATABASE_URL=postgresql://cloudnotes_user:changeme@your-rds-endpoint.rds.amazonaws.com:5432/cloudnotes
PGSSL=true

# --- S3 (image storage) ---
AWS_REGION=us-east-1
S3_BUCKET_NAME=cloudnotes-uploads-yourname

# --- Secrets Manager (optional, recommended for production) ---
# If set, the app will fetch DATABASE_URL from this secret instead of the env var above.
USE_SECRETS_MANAGER=false
SECRETS_MANAGER_SECRET_NAME=cloudnotes/prod/db

# --- IAM ---
# No AWS access keys go here! On EC2 / Elastic Beanstalk / App Runner, the app
# authenticates using an attached IAM Instance Profile / Task Role instead.
# Only set these two if running purely locally without an instance profile:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
